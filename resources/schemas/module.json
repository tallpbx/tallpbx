{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "TallPBX Module Manifest",
    "description": "Schema for TallPBX module.json manifest files.",
    "type": "object",
    "required": [
        "name",
        "version",
        "namespace",
        "display_name"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Reference to this JSON schema file."
        },
        "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Machine name (lowercase, hyphen-separated)."
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version (e.g., 1.0.0)."
        },
        "namespace": {
            "type": "string",
            "pattern": "^(Modules|CustomModules)\\\\[A-Z][a-zA-Z0-9_]*$",
            "description": "PHP namespace (e.g., Modules\\CallForwarding for built-in modules or CustomModules\\MyPlugin for custom modules)."
        },
        "display_name": {
            "type": "string",
            "description": "Human-readable name shown in the UI."
        },
        "description": {
            "type": "string",
            "description": "Short description of the module's purpose."
        },
        "source": {
            "type": "string",
            "enum": ["core", "custom", "vendor"],
            "description": "Where the module lives: core app-modules/ monorepo code (default, tagged by discovery), untracked custom-modules/ module, or vendor package. Not declared in built-in manifests; discovery tags it.",
            "default": "core"
        },
        "category": {
            "type": "string",
            "enum": ["core", "accounts", "connectivity", "routing", "features", "media", "advanced", "monitoring", "custom"],
            "description": "Canonical UI navigation group (plan §1.6) rendered by the /panel/modules workbench. The 'custom' value is assigned to third-party modules only.",
            "default": "core"
        },
        "required": {
            "type": "boolean",
            "description": "If true, the module cannot be disabled.",
            "default": false
        },
        "protected": {
            "type": "boolean",
            "description": "If true, the module cannot be uninstalled.",
            "default": false
        },
        "priority": {
            "type": "integer",
            "description": "Loading order (lower values load first).",
            "default": 0
        },
        "providers": {
            "type": "array",
            "description": "Service provider classes to register.",
            "items": {
                "type": "string"
            },
            "uniqueItems": true
        },
        "requirements": {
            "type": "object",
            "description": "Runtime dependency constraints.",
            "properties": {
                "php": {
                    "type": "string",
                    "description": "Required PHP version constraint (e.g., >=8.5)."
                },
                "laravel": {
                    "type": "string",
                    "description": "Required Laravel version constraint (e.g., >=13.0)."
                },
                "modules": {
                    "type": "array",
                    "description": "Required TallPBX module machine names (enforced by ModuleBoundaryTest).",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                    }
                },
                "packages": {
                    "type": "array",
                    "description": "Required Composer packages.",
                    "items": {
                        "type": "object",
                        "required": ["name", "version"],
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Composer package name."
                            },
                            "version": {
                                "type": "string",
                                "description": "Version constraint."
                            }
                        }
                    }
                }
            }
        }
    }
}
