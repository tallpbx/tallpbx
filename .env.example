APP_NAME=TallPBX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tallpbx
DB_USERNAME=tallpbx
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=cache
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tallpbx
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=""
VITE_REVERB_PORT=""
VITE_REVERB_SCHEME="http"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=
FREESWITCH_XML_HANDLER_DIALPLAN_CACHE_TTL=5
FREESWITCH_XML_HANDLER_DIALPLAN_CONTRIBUTOR_CACHE_TTL=5
FREESWITCH_XML_HANDLER_DIRECTORY_CACHE_TTL=5
FREESWITCH_XML_HANDLER_DIALPLAN_CACHE_STORE=redis
FREESWITCH_HIREDIS_DIALPLAN_LIMIT_ENABLED=false
FREESWITCH_HIREDIS_DIALPLAN_LIMIT_MAX=100000
FREESWITCH_HIREDIS_DIALPLAN_MARKER_ENABLED=false
FREESWITCH_SWITCH_LOG_LEVEL=debug

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FreeSWITCH ESL Connection
FREESWITCH_SERVER=http://127.0.0.1
FREESWITCH_DEFAULT_SIP_REALM=127.0.0.1
TALLPBX_MEDIA_ROOT=/var/lib/tallpbx/media
TALLPBX_BACKUP_ROOT=/var/lib/tallpbx/backups
# Installer demo seed mode (set by scripts/install.sh)
FSPBX_DEMO_MODE=false
# Installer development tooling mode (set by scripts/install.sh)
FSPBX_DEVELOPMENT_MODE=false
FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon
FREESWITCH_XML_HANDLER_AUTH=true
FREESWITCH_XML_HANDLER_PATH=/api/v1/xml-handler
FREESWITCH_XML_HANDLER_TOKEN=
FREESWITCH_XML_HANDLER_LOG_REQUESTS=false
PBX_DEFAULT_SIP_PASSWORD=

# FreeSWITCH Runtime Database
# sqlite is FreeSWITCH's default. Use mariadb, pgsql, or odbc to externalize FreeSWITCH-owned runtime tables.
FREESWITCH_DATABASE_DRIVER=sqlite
# FREESWITCH_DATABASE_DSN=mariadb://Server=127.0.0.1;Port=3306;Database=freeswitch;Uid=freeswitch;Pwd=secret;
# FREESWITCH_DATABASE_ODBC_DSN=dsn:username:password
FREESWITCH_DATABASE_HOST=127.0.0.1
FREESWITCH_DATABASE_PORT=3306
FREESWITCH_DATABASE_NAME=freeswitch
FREESWITCH_DATABASE_USERNAME=freeswitch
FREESWITCH_DATABASE_PASSWORD=
FREESWITCH_DATABASE_OPTIONS=
# FREESWITCH_CORE_DB_NAME=/var/lib/freeswitch/db/core.db
FREESWITCH_AUTO_CREATE_SCHEMAS=true
FREESWITCH_CORE_NON_SQLITE_DB_REQUIRED=false
FREESWITCH_ODBC_SKIP_AUTOCOMMIT_FLIP=false

# FreeSWITCH Sofia Global Settings
FREESWITCH_SOFIA_LOG_LEVEL=0
FREESWITCH_SOFIA_AUTO_RESTART=true
FREESWITCH_SOFIA_DEBUG_PRESENCE=false
FREESWITCH_SOFIA_CAPTURE_SERVER=
FREESWITCH_SOFIA_INBOUND_REG_THREAD=true
FREESWITCH_SOFIA_MAX_REG_THREADS=8
