APP_NAME=TallPBX
# The installer switches this to local (with debug on) for development-mode
# installs; production installs keep the safe defaults below.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tallpbx
DB_USERNAME=tallpbx
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=cache
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Secure cookies require HTTPS: the installer raises this to true
# automatically once a TLS certificate is active. Keep it false only for a
# plain-HTTP development server, otherwise browsers will not send the
# login cookie at all.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tallpbx
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=""
VITE_REVERB_PORT=""
VITE_REVERB_SCHEME="http"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# FREESWITCH SETTINGS
# ==============================================================================

# FreeSWITCH Connection & SIP Provisioning
FS_SERVER=http://127.0.0.1
FS_DEFAULT_SIP_REALM=127.0.0.1
FS_ESL_HOST=127.0.0.1
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon

# Telephony XML Handler
FS_XML_HANDLER_AUTH=true
FS_XML_HANDLER_PATH=/api/v1/xml-handler
FS_XML_HANDLER_TOKEN=
FS_XML_HANDLER_LOG_REQUESTS=false

# Master XML cache duration (in seconds) for FreeSWITCH XML handler responses.
# Changing this single setting updates dialplan, contributor, directory, and ACL caches simultaneously.
#
# To customize caching for a specific subsystem, uncomment the individual setting below
# to override the master default. When commented out, each setting automatically inherits the master default.
FS_XML_HANDLER_CACHE_TTL=5
# FS_XML_HANDLER_DIALPLAN_CACHE_TTL=5
# FS_XML_HANDLER_CONTRIBUTOR_CACHE_TTL=5
# FS_XML_HANDLER_DIRECTORY_CACHE_TTL=5
# FS_XML_HANDLER_ACL_CACHE_TTL=5

# Master XML cache store (e.g. redis, file). Defaults to CACHE_STORE if not set.
# Changing this single setting updates dialplan, contributor, directory, and ACL cache backends.
# Uncomment any individual setting below if you need a specific backend override.
FS_XML_HANDLER_CACHE_STORE=redis
# FS_XML_HANDLER_DIALPLAN_CACHE_STORE=redis
# FS_XML_HANDLER_DIRECTORY_CACHE_STORE=redis
# FS_XML_HANDLER_ACL_CACHE_STORE=redis

# Core Engine & Hiredis Options
FS_LOG_LEVEL=debug
FS_SESSIONS_PER_SECOND=60
FS_HIREDIS_LIMIT_ENABLED=false
FS_HIREDIS_LIMIT_MAX=100000
FS_HIREDIS_MARKER_ENABLED=false

# PBX Defaults, Media & Backups
PBX_DEFAULT_SIP_PASSWORD=
TALLPBX_MEDIA_ROOT=/var/lib/tallpbx/media
TALLPBX_BACKUP_ROOT=/var/lib/tallpbx/backups
# Installer demo seed mode (set by scripts/install.sh)
PBX_DEMO_MODE=false
# Installer development tooling mode (set by scripts/install.sh)
FSPBX_DEVELOPMENT_MODE=false

# FreeSWITCH Runtime Database
# sqlite is FreeSWITCH's default. Use mariadb, pgsql, or odbc to externalize FreeSWITCH-owned runtime tables.
FS_DB_DRIVER=sqlite
# FS_DB_DSN=mariadb://Server=127.0.0.1;Port=3306;Database=freeswitch;Uid=freeswitch;Pwd=secret;
# FS_DB_ODBC_DSN=dsn:username:password
FS_DB_HOST=127.0.0.1
FS_DB_PORT=3306
FS_DB_NAME=freeswitch
FS_DB_USERNAME=freeswitch
FS_DB_PASSWORD=
FS_DB_OPTIONS=
# FS_CORE_DB_NAME=/var/lib/freeswitch/db/core.db
FS_AUTO_CREATE_SCHEMAS=true
FS_CORE_NON_SQLITE_DB_REQUIRED=false
FS_ODBC_SKIP_AUTOCOMMIT_FLIP=false

# FreeSWITCH Sofia Global Settings
FS_SOFIA_LOG_LEVEL=0
FS_SOFIA_AUTO_RESTART=true
FS_SOFIA_DEBUG_PRESENCE=false
FS_SOFIA_CAPTURE_SERVER=
FS_SOFIA_INBOUND_REG_THREAD=true
FS_SOFIA_MAX_REG_THREADS=8
