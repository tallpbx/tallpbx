[Unit]
Description=TallPBX CDR Stream Ingestion Worker
Documentation=https://github.com/tallpbx/tallpbx
After=network.target mariadb.service redis-server.service
Wants=mariadb.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tallpbx
ExecStart=/usr/bin/php artisan cdr:work --chunk=100 --sleep=250000 --memory=512

# Restart policy: always restart on failure, with a 3-second delay
Restart=always
RestartSec=3

# Prevent systemd from restarting too aggressively
StartLimitInterval=60
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tallpbx-cdr-worker

# Security hardening. Unlike the scheduler, this worker never elevates
# privileges, so NoNewPrivileges stays on.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# The worker writes its quarantine copies into the CDR spool tree that it
# reconciles, and bootstrap/cache must stay writable so it can rebuild the
# package manifest after `php artisan optimize:clear` instead of crash-looping.
ReadWritePaths=/var/www/tallpbx/storage /var/www/tallpbx/bootstrap/cache /var/log/freeswitch/json_cdr
ReadOnlyPaths=/var/www/tallpbx

# Environment (adjust APP_ENV as needed)
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target
