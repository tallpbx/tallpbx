[Unit]
Description=TallPBX Laravel Reverb WebSocket Server
Documentation=https://github.com/tallpbx/tallpbx
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tallpbx
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080

# Restart policy: always restart on failure, with a 5-second delay
Restart=always
RestartSec=5

# Prevent systemd from restarting too aggressively
StartLimitInterval=60
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tallpbx-reverb

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# bootstrap/cache stays writable so the server can rebuild the package
# manifest after `php artisan optimize:clear` instead of crash-looping.
ReadWritePaths=/var/www/tallpbx/storage /var/www/tallpbx/bootstrap/cache
ReadOnlyPaths=/var/www/tallpbx

# Environment (adjust APP_ENV as needed)
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target
