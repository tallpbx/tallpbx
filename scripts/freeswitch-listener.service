[Unit]
Description=TallPBX FreeSWITCH ESL Event Listener
Documentation=https://github.com/tallpbx/tallpbx
After=network.target freeswitch.service
Wants=freeswitch.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tallpbx
ExecStart=/usr/bin/php artisan freeswitch:listen

# Restart policy: always restart on failure, with a 5-second delay
Restart=always
RestartSec=5

# Prevent systemd from restarting too aggressively
StartLimitInterval=60
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tallpbx-freeswitch-listener

# Security hardening.
#
# NoNewPrivileges is intentionally NOT set: this service executes the bounded
# sudoers helper (/usr/local/sbin/tallpbx-security) for kernel firewall bans,
# and that elevation requires the setuid transition systemd would otherwise
# block. For the same reason /etc/tallpbx (the helper's ruleset, sidecar, and
# threat feed files) stays read-write inside the ProtectSystem=strict sandbox,
# and bootstrap/cache must stay writable so the service can rebuild the package
# manifest after `php artisan optimize:clear`.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/tallpbx/storage /var/lib/tallpbx/media /var/www/tallpbx/bootstrap/cache /etc/tallpbx
ReadOnlyPaths=/var/www/tallpbx

# Environment (adjust APP_ENV as needed)
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target
