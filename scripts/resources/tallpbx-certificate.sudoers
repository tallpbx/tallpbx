# ==============================================================================
# TallPBX Bounded Host Certificate Management Sudoers Configuration
#
# Allows the web application user (www-data) to invoke the bounded host certificate
# helper script (/usr/local/sbin/tallpbx-certificate) with root privileges without a password.
#
# Security Controls:
# - Restricted strictly to a single executable (/usr/local/sbin/tallpbx-certificate).
# - Runas pinned to root, so www-data cannot invoke the helper as any other user account.
# - No wildcard arguments or arbitrary shell commands are permitted.
# ==============================================================================
www-data ALL=(root) NOPASSWD: /usr/local/sbin/tallpbx-certificate
