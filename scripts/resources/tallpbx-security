#!/bin/bash
# ==============================================================================
# TallPBX Bounded Host Security Helper
#
# Purpose:
# This script executes privileged Linux kernel packet filtering operations on
# behalf of the TallPBX web management interface (www-data).
#
# Security Architecture:
# - Strictly bounded interface: Only 'apply', 'validate', 'ban', 'unban', and 'status' are allowed.
# - Input validation: IP addresses and durations are rigorously validated with regular
#   expressions before being passed to nftables, preventing any arbitrary command injection.
# - Atomic ruleset updates: Pending firewall rulesets are validated with 'nft -c'
#   BEFORE being applied, preventing accidental firewall lockouts or syntax errors.
# - Zero-Daemon Kernel Banning: Intruder IP bans are added directly to the nftables
#   dynamic sets '@banned_ips' (IPv4) and '@banned_ips6' (IPv6) with
#   kernel-level automatic timeouts.
# ==============================================================================
set -euo pipefail

ACTION="${1:-}"

# Strict regular expression matching valid IPv4 addresses and CIDR subnets with
# bounded octets (0-255) and prefix lengths (0-32), e.g. 192.168.1.5 or 10.0.0.0/24
IPV4_REGEX="^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(/(3[0-2]|[12]?[0-9]))?$"

# Strict regular expression matching valid IPv6 addresses (including compressed
# "::" forms) and CIDR subnets with prefix lengths 0-128, e.g. 2001:db8::1 or 2001:db8::/64
IPV6_REGEX="^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))(/(12[0-8]|1[01][0-9]|[0-9]{1,2}))?$"

# Strict regular expression matching positive integers (seconds)
SECONDS_REGEX="^[0-9]{1,9}$"

# Directory holding the generated firewall rulesets. Defaults to the production
# location. Automated tests point TALLPBX_FIREWALL_CONF_DIR at a throwaway
# directory so they can exercise this script without reading or rewriting live
# host state. Sudo does not pass environment variables through (env_reset), so
# this override cannot be used to redirect the helper when it runs via sudoers.
FIREWALL_CONF_DIR="${TALLPBX_FIREWALL_CONF_DIR:-/etc/tallpbx}"
FIREWALL_PENDING="${FIREWALL_CONF_DIR}/firewall.nft.pending"
FIREWALL_ACTIVE="${FIREWALL_CONF_DIR}/firewall.nft"

# Path to the nftables binary. Defaults to system binary. Automated tests point
# TALLPBX_NFT_BIN at a stub binary in a temporary directory. Sudo's env_reset
# prevents this environment variable from affecting production invocations.
NFT_BIN="${TALLPBX_NFT_BIN:-/usr/sbin/nft}"

# Helper function to validate IP addresses
validate_ip() {
    local ip="$1"
    if [[ "$ip" =~ $IPV4_REGEX ]] || [[ "$ip" =~ $IPV6_REGEX ]]; then
        return 0
    else
        echo "ERROR: Invalid IP address or CIDR format: '$ip'" >&2
        exit 2
    fi
}

# Helper function to pick the kernel ban set that matches the address family
# of the given IP. nftables sets are typed per family, so IPv4 bans live in
# 'banned_ips' and IPv6 bans live in the mirrored 'banned_ips6' set.
ban_set_for_ip() {
    if [[ "$1" =~ $IPV4_REGEX ]]; then
        echo "banned_ips"
    else
        echo "banned_ips6"
    fi
}

case "$ACTION" in
    apply)
        # Step 1: Ensure a pending firewall configuration file has been generated by the web panel
        if [ ! -f "$FIREWALL_PENDING" ]; then
            echo "ERROR: Pending firewall configuration file not found: $FIREWALL_PENDING" >&2
            exit 1
        fi

        # Step 2: Validate the syntax of the pending ruleset before touching the live firewall.
        # If there are any syntax errors, 'nft -c' will fail here and exit, keeping the active firewall intact.
        "$NFT_BIN" -c -f "$FIREWALL_PENDING"

        # Step 3: Promote the pending file to the active configuration file atomically
        mv "$FIREWALL_PENDING" "$FIREWALL_ACTIVE"
        chown root:www-data "$FIREWALL_ACTIVE" 2>/dev/null || true
        chmod 0640 "$FIREWALL_ACTIVE" 2>/dev/null || true

        # Step 4: Load the validated configuration into the Linux kernel atomically
        "$NFT_BIN" -f "$FIREWALL_ACTIVE"

        # Step 5: Post-apply verification and authoritative sidecar creation
        DECLARED_POLICY="$(sed -n 's/^# tallpbx-policy:[[:space:]]*\([a-z]*\).*/\1/p' "$FIREWALL_ACTIVE")"
        RULESET_DIGEST="$(sed -n 's/^# tallpbx-digest:[[:space:]]*\(sha256:[0-9a-f]\{64\}\).*/\1/p' "$FIREWALL_ACTIVE")"
        LIVE_CHAIN="$("$NFT_BIN" list chain inet tallpbx_filter input 2>/dev/null || true)"
        LIVE_POLICY="$(printf '%s\n' "$LIVE_CHAIN" | sed -n 's/.*hook input[^;]*; policy \([a-z]*\);.*/\1/p')"

        SIDECAR="${FIREWALL_CONF_DIR}/firewall.nft.applied"
        if [ -n "$DECLARED_POLICY" ] && [ -n "$RULESET_DIGEST" ] && [ "$LIVE_POLICY" = "$DECLARED_POLICY" ]; then
            SIDECAR_TMP="${SIDECAR}.tmp.$$"
            printf 'digest=%s\npolicy=%s\napplied_at=%s\n' \
                "$RULESET_DIGEST" "$DECLARED_POLICY" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$SIDECAR_TMP"
            chown root:www-data "$SIDECAR_TMP" 2>/dev/null || true
            chmod 0640 "$SIDECAR_TMP" 2>/dev/null || true
            mv -f "$SIDECAR_TMP" "$SIDECAR"
            echo "SUCCESS: Ruleset applied atomically and verified against the live kernel"
        else
            # Invalidate any existing stale sidecar so the verifier reports unverified rather than stale success
            rm -f "$SIDECAR"
            echo "WARNING: Ruleset applied, but the live kernel policy could not be verified - sync sidecar invalidated" >&2
        fi
        ;;

    validate)
        # Ensure a pending firewall configuration file has been generated by the web panel
        if [ ! -f "$FIREWALL_PENDING" ]; then
            echo "ERROR: Pending firewall configuration file not found: $FIREWALL_PENDING" >&2
            exit 1
        fi

        # Run the kernel's own parser in check-only mode. 'nft -c' validates the
        # complete ruleset syntax WITHOUT applying it, so the live kernel
        # firewall is never modified by this action.
        "$NFT_BIN" -c -f "$FIREWALL_PENDING"
        echo "SUCCESS: Pending ruleset syntax is valid"
        ;;

    ban)
        IP="${2:-}"
        SECS="${3:-3600}"

        # Validate the IP address parameter
        validate_ip "$IP"

        # Validate the duration parameter (must be numeric seconds)
        if [[ ! "$SECS" =~ $SECONDS_REGEX ]]; then
            echo "ERROR: Invalid seconds duration: '$SECS'" >&2
            exit 3
        fi

        # Family-matched kernel set (banned_ips for IPv4, banned_ips6 for IPv6)
        BAN_SET="$(ban_set_for_ip "$IP")"

        # Ensure table exists in kernel before adding element; restore active ruleset if needed
        if ! "$NFT_BIN" list table inet tallpbx_filter &>/dev/null; then
            if [ -f "$FIREWALL_ACTIVE" ]; then
                "$NFT_BIN" -f "$FIREWALL_ACTIVE" 2>/dev/null || true
            fi
        fi

        # If seconds is 0, ban permanently (no timeout), otherwise apply kernel timeout
        if [ "$SECS" -eq 0 ]; then
            "$NFT_BIN" add element inet tallpbx_filter "$BAN_SET" { "$IP" }
            echo "SUCCESS: Banned $IP permanently"
        else
            "$NFT_BIN" add element inet tallpbx_filter "$BAN_SET" { "$IP" timeout "${SECS}s" }
            echo "SUCCESS: Banned $IP for $SECS seconds"
        fi
        ;;

    unban)
        IP="${2:-}"

        # Validate the IP address parameter
        validate_ip "$IP"

        # Family-matched kernel set (banned_ips for IPv4, banned_ips6 for IPv6)
        UNBAN_SET="$(ban_set_for_ip "$IP")"

        # Ensure table exists in kernel before deleting element
        if ! "$NFT_BIN" list table inet tallpbx_filter &>/dev/null; then
            if [ -f "$FIREWALL_ACTIVE" ]; then
                "$NFT_BIN" -f "$FIREWALL_ACTIVE" 2>/dev/null || true
            fi
        fi

        # Remove the IP element from the kernel dynamic set; ignore if element was not present
        "$NFT_BIN" delete element inet tallpbx_filter "$UNBAN_SET" { "$IP" } 2>/dev/null || true
        echo "SUCCESS: Unbanned $IP"
        ;;

    status)
        # Display the active nftables ruleset or table status
        if "$NFT_BIN" list table inet tallpbx_filter &>/dev/null; then
            "$NFT_BIN" list table inet tallpbx_filter
        else
            "$NFT_BIN" list ruleset
        fi
        ;;

    bans)
        # Emit kernel dynamic ban sets in structured JSON format
        if "$NFT_BIN" list table inet tallpbx_filter &>/dev/null; then
            "$NFT_BIN" -j list sets inet tallpbx_filter 2>/dev/null || echo '{"nftables":[]}'
        else
            echo '{"nftables":[]}'
        fi
        ;;

    *)
        echo "Usage: $0 {apply|validate|ban <ip> [seconds]|unban <ip>|status|bans}" >&2
        exit 1
        ;;
esac
