[Unit]
# Each service instance accepts the restore-operation UUID as its sole argument.
Description=TallPBX privileged restore operation
After=network.target mariadb.service redis-server.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/tallpbx
ExecStart=/usr/local/sbin/tallpbx-restore %i
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
