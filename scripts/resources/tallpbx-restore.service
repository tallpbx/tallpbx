[Unit]
# Each service instance accepts the restore-operation UUID as its sole argument.
Description=TallPBX privileged restore operation
After=network.target mariadb.service redis-server.service

[Service]
Type=oneshot
# A whole restore, including file copies, must stop within one hour. systemd
# bounds work even when PHP is blocked inside a filesystem operation.
TimeoutStartSec=3599s
TimeoutStopSec=1s
User=root
Group=root
WorkingDirectory=/var/www/tallpbx
ExecStart=/usr/local/sbin/tallpbx-restore %i
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
