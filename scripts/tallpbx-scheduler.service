[Unit]
Description=TallPBX Laravel Scheduler
Documentation=https://github.com/tallpbx/tallpbx
After=network.target mariadb.service redis-server.service
Wants=mariadb.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tallpbx
ExecStart=/usr/bin/php artisan schedule:work

# Restart policy: always restart on failure, with a 5-second delay
Restart=always
RestartSec=5

# Prevent systemd from restarting too aggressively
StartLimitInterval=60
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tallpbx-scheduler

# Security hardening.
#
# NoNewPrivileges is intentionally NOT set: the scheduled security jobs
# (security:verify, security:reconcile, security:sync-threat-feeds) execute
# the bounded sudoers helper (/usr/local/sbin/tallpbx-security) for kernel
# firewall operations, and that elevation requires the setuid transition
# systemd would otherwise block. For the same reason /etc/tallpbx (the
# helper's ruleset, sidecar, and threat feed files) stays read-write inside
# the ProtectSystem=strict sandbox, and bootstrap/cache must stay writable so
# the service can rebuild the package manifest after `php artisan optimize:clear`.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/tallpbx/storage /var/lib/tallpbx/media /var/www/tallpbx/bootstrap/cache /etc/tallpbx
ReadOnlyPaths=/var/www/tallpbx

# Environment (adjust APP_ENV as needed)
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target
