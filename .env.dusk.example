# Dusk browser-test environment. `php artisan dusk` temporarily swaps this file
# in as the active `.env` for the duration of a test run, then restores the real
# `.env`. Do not use the web panel while browser tests are running — any request
# in that window runs against the disposable Dusk database and can make tests
# fail. See INSTALL.md, section "Browser Testing (Dusk)".
APP_NAME=TallPBX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
DUSK_TESTING=true
BCRYPT_ROUNDS=4

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tallpbx_dusk
DB_USERNAME=tallpbx_dusk
DB_PASSWORD=rush
TALLPBX_PRIMARY_DATABASE=tallpbx

SESSION_DRIVER=file
CACHE_STORE=array
