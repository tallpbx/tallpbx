{
    "name": "tallpbx/file-stores",
    "description": "Reusable destination profiles for TallPBX file storage.",
    "type": "tallpbx-module",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Modules\\FileStores\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3",
        "laravel/framework": ">=13.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-ftp": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "spatie/flysystem-dropbox": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\FileStores\\Providers\\ModuleServiceProvider"
            ]
        }
    }
}
